# Mood Taster environment variables
#
# Copy to .env for local development. Never commit .env with real values.
#
# EVERY variable is optional. The guest quiz works with an empty environment.
#
# Supabase public keys use NEXT_PUBLIC_ on purpose (browser Auth client).
# SUPABASE_SERVICE_ROLE_KEY must NEVER be NEXT_PUBLIC_.


# ============================================================================
# BUILD TIME: Canonical public origin
# ============================================================================
# Drives metadataBase, canonical tags, robots.txt, and sitemap.xml.
#
# Only needed for a custom domain. On Vercel this falls back to
# VERCEL_PROJECT_PRODUCTION_URL, which is the stable production host. Note that
# VERCEL_URL is deliberately NOT used: it is per deployment, so it would put
# preview hostnames into canonical tags and share cards.

NEXT_PUBLIC_SITE_URL=


# ============================================================================
# RUNTIME: Supabase Auth + Postgres (optional accounts)
# ============================================================================
# Create a project at https://supabase.com, then:
#   1. Project Settings → API
#   2. Project URL  → NEXT_PUBLIC_SUPABASE_URL
#      Must look like: https://xxxx.supabase.co
#      NOT the database connection string (postgresql://...)
#   3. anon public  → NEXT_PUBLIC_SUPABASE_ANON_KEY
#   4. service_role → SUPABASE_SERVICE_ROLE_KEY (server only, never NEXT_PUBLIC_)
#   5. SQL Editor: run supabase/schema.sql
#   6. Auth → Email: enable. For local demos, turn off "Confirm email"
#
# Guest quiz works without these. Username login needs the service role key.
# Email login works with URL + anon key alone.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=


# ============================================================================
# BUILD TIME: Gemini, free tier
# ============================================================================

GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_BATCH_SIZE=10


# ============================================================================
# RUNTIME: Azure OpenAI, Foundry v1 Responses API
# ============================================================================

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# Reasoning model. Default effort "medium" costs latency and spends
# max_output_tokens on internal reasoning before any text is emitted.
AZURE_OPENAI_REASONING_EFFORT=low


# ============================================================================
# RUNTIME: Google Places + Geocoding
# ============================================================================
# Server side only, never NEXT_PUBLIC_.
#
# This key must NOT carry an HTTP referrer restriction. Server calls send no
# referrer, so a browser-restricted key returns 403
# API_KEY_HTTP_REFERRER_BLOCKED. Set Application restrictions to None and use
# API restrictions to scope it instead.
#
# Enable both on the same key:
#   - Places API (New)  → nearby search for Eat out
#   - Geocoding API     → city / ZIP fallback when browser location is off
# No separate geocode env var; GOOGLE_PLACES_API_KEY is reused.

GOOGLE_PLACES_API_KEY=

# Must match a referrer pattern allowed on the Places key. Server calls send no
# Referer header by default, so a referrer-restricted key returns
# 403 API_KEY_HTTP_REFERRER_BLOCKED until this is set.
PLACES_REFERRER=https://mood-taster.vercel.app/


# ============================================================================
# RUNTIME: Product analytics (optional)
# ============================================================================
# PostHog project API key (Project Settings → Project API Key).
# Without these, track() no-ops and the guest quiz still works.
# Build a funnel insight: home_viewed → recommendation_shown →
# feedback_submitted (filter successful = true) for Successful Taste Sessions.

NEXT_PUBLIC_POSTHOG_KEY=
# US cloud default. EU projects: https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
