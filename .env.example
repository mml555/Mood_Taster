# Mood Taster environment variables
#
# Copy to .env for local development. Never commit .env with real values.
#
# There are TWO CLASSES of variable here and they belong in different places.
# Getting this wrong is how a key ends up somewhere it should not be, or how a
# build script silently no-ops.
#
#   BUILD TIME (Gemini)  local machine only.   Do NOT set these in Vercel.
#   RUNTIME    (Azure)   Vercel Production.    Also local, to test the path.
#
# EVERY variable is optional. The product builds, deploys, and passes the full
# demo with an empty environment. Anything that throws on a missing key is a bug.
#
# NOTHING here is NEXT_PUBLIC_. There is no legitimate NEXT_PUBLIC_ variable in
# this build. Prefixing any of these ships the secret to the browser.


# ============================================================================
# BUILD TIME: Gemini, free tier
# ============================================================================
# Used ONLY by scripts/generate-explanations.ts, which precomputes every dish
# explanation and commits the result to src/lib/explanations.json. Gemini never
# runs in production and this key is never set in Vercel.
#
# Google AI Studio: https://aistudio.google.com/apikey

GEMINI_API_KEY=

# MODEL CHOICE IS A QUOTA DECISION, NOT A QUALITY ONE.
# Free tier requests-per-day, measured on this project:
#
#   Flash Lite variants (3.1, 3.5)     500 RPD, 15 RPM   <- use one of these
#   Flash variants (2.5, 3, 3.5, 3.6)   20 RPD,  5 RPM   <- unusable
#
# The 20 RPD tier cannot even complete one generation run. Rewriting short
# sentences does not need a Flash tier model.
#
# Confirm the exact model id string against the current API docs before setting.
GEMINI_MODEL=

# Combos batched into a single request. Batching is a QUOTA REQUIREMENT, not an
# optimization: unbatched, one full run is ~960 requests and blows the 500 RPD
# ceiling outright. At 10 per call a run costs ~96 requests, so the catalog can
# be regenerated several times in one day. Late catalog changes need that.
GEMINI_BATCH_SIZE=10


# ============================================================================
# RUNTIME: Azure OpenAI
# ============================================================================
# The live path on the result screen. It rewrites the already-good precomputed
# line into something fresher, after paint, with a hard timeout. If it is slow,
# down, or unset, the precomputed line stays and nothing visibly breaks.
#
# All four are needed together. Three of four means "Azure not configured" and
# the runtime call is skipped entirely, not attempted and failed.

# Resource endpoint, no trailing slash, for example
# https://your-resource.openai.azure.com
AZURE_OPENAI_ENDPOINT=

AZURE_OPENAI_API_KEY=

# The DEPLOYMENT name you chose in Azure, not the model name. These are
# frequently different and it is the most common Azure OpenAI misconfiguration.
AZURE_OPENAI_DEPLOYMENT=

# Required by the Azure REST API as an ?api-version= query parameter. Requests
# fail without it. Set to the version your deployment supports.
AZURE_OPENAI_API_VERSION=
