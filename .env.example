# Mood Taster environment variables
#
# Copy to .env for local development. Never commit .env with real values.
#
# EVERY variable is optional. The guest quiz works with an empty environment.
#
# Supabase public keys use NEXT_PUBLIC_ on purpose (browser Auth client).
# SUPABASE_SERVICE_ROLE_KEY must NEVER be NEXT_PUBLIC_.


# ============================================================================
# RUNTIME: Supabase Auth + Postgres (optional accounts)
# ============================================================================
# Create a project at https://supabase.com, then:
#   1. Project Settings → API: copy Project URL and anon public key
#   2. Paste service_role key into SUPABASE_SERVICE_ROLE_KEY (server only)
#   3. SQL Editor: run supabase/schema.sql
#   4. Auth → Providers: Email enabled. For local demos you may disable
#      "Confirm email" so signup returns a session immediately.
#
# Guest quiz works without these. Username login needs the service role key.
# Email login works with URL + anon key alone.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=


# ============================================================================
# BUILD TIME: Gemini, free tier
# ============================================================================

GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_BATCH_SIZE=10


# ============================================================================
# RUNTIME: Azure OpenAI, Foundry v1 Responses API
# ============================================================================

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
